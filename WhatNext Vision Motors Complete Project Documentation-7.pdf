BT 1 0 0 1 6 213.2 Tm /F5 7.6 Tf 9.6 TL (private static void updateStockOnOrderPlacement\() Tj T* (        List<Vehicle_Order__c> orders, Map<Id, Vehicle_Order__c> oldOrders\) {) Tj T*  T* (    Map<Id, Integer> countByVehicle = new Map<Id, Integer>\(\);) Tj T* (    for \(Vehicle_Order__c o : orders\) {) Tj T* (        Boolean wasConfirmed = oldOrders != null && oldOrders.containsKey\(o.Id\)) Tj T* (            && oldOrders.get\(o.Id\).Status__c == 'Confirmed';) Tj T* (        if \(o.Vehicle__c != null && o.Status__c == 'Confirmed' && !wasConfirmed\) {) Tj T* (            Integer c = countByVehicle.containsKey\(o.Vehicle__c\)) Tj T* (                ? countByVehicle.get\(o.Vehicle__c\) : 0;) Tj T* (            countByVehicle.put\(o.Vehicle__c, c + 1\);) Tj T* (        }) Tj T* (    }) Tj T* (    if \(countByVehicle.isEmpty\(\)\) return;) Tj T*  T* (    List<Vehicle__c> toUpdate = [SELECT Id, Stock_Quantity__c FROM Vehicle__c) Tj T* (                                 WHERE Id IN :countByVehicle.keySet\(\)];) Tj T* (    for \(Vehicle__c v : toUpdate\) {) Tj T* (        Decimal stock = \(v.Stock_Quantity__c == null\) ? 0 : v.Stock_Quantity__c;) Tj T* (        v.Stock_Quantity__c = Math.max\(0, stock - countByVehicle.get\(v.Id\)\);) Tj T* (    }) Tj T* (    update toUpdate;) Tj T* (}) Tj T* ET
Q
