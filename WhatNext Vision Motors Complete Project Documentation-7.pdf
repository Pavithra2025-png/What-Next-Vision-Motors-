BT 1 0 0 1 6 213.2 Tm /F5 7.6 Tf 9.6 TL (global class VehicleOrderBatch implements Database.Batchable<sObject> {) Tj T*  T* (    global Database.QueryLocator start\(Database.BatchableContext bc\) {) Tj T* (        return Database.getQueryLocator\([) Tj T* (            SELECT Id, Status__c, Vehicle__c) Tj T* (            FROM Vehicle_Order__c) Tj T* (            WHERE Status__c = 'Pending') Tj T* (        ]\);) Tj T* (    }) Tj T*  T* (    global void execute\(Database.BatchableContext bc, List<Vehicle_Order__c> orderList\) {) Tj T* (        Set<Id> vehicleIds = new Set<Id>\(\);) Tj T* (        for \(Vehicle_Order__c order : orderList\) {) Tj T* (            if \(order.Vehicle__c != null\) {) Tj T* (                vehicleIds.add\(order.Vehicle__c\);) Tj T* (            }) Tj T* (        }) Tj T*  T* (        if \(!vehicleIds.isEmpty\(\)\) {) Tj T* (            Map<Id, Vehicle__c> vehicleStockMap = new Map<Id, Vehicle__c>\() Tj T* (                [SELECT Id, Stock_Quantity__c FROM Vehicle__c WHERE Id IN :vehicleIds]) Tj T* (            \);) Tj T* (            // ... continues on the next page) Tj T* ET
