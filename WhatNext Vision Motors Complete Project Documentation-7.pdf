BT 1 0 0 1 6 261.2 Tm /F5 7.6 Tf 9.6 TL (// Decrease stock when an order is confirmed) Tj T* (private static void updateStockOnOrderPlacement\(List<Vehicle_Order__c> orders\) {) Tj T* (    Set<Id> vehicleIds = new Set<Id>\(\);) Tj T* (    for \(Vehicle_Order__c order : orders\) {) Tj T* (        if \(order.Vehicle__c != null && order.Status__c == 'Confirmed'\) {) Tj T* (            vehicleIds.add\(order.Vehicle__c\);) Tj T* (        }) Tj T* (    }) Tj T*  T* (    if \(!vehicleIds.isEmpty\(\)\) {) Tj T* (        Map<Id, Vehicle__c> vehicleStockMap = new Map<Id, Vehicle__c>\() Tj T* (            [SELECT Id, Stock_Quantity__c FROM Vehicle__c WHERE Id IN :vehicleIds]) Tj T* (        \);) Tj T*  T* (        List<Vehicle__c> vehiclesToUpdate = new List<Vehicle__c>\(\);) Tj T* (        for \(Vehicle_Order__c order : orders\) {) Tj T* (            Vehicle__c vehicle = vehicleStockMap.get\(order.Vehicle__c\);) Tj T* (            if \(vehicle != null && vehicle.Stock_Quantity__c > 0\) {) Tj T* (                vehicle.Stock_Quantity__c -= 1;) Tj T* (                vehiclesToUpdate.add\(vehicle\);) Tj T* (            }) Tj T* (        }) Tj T*  T* (        if \(!vehiclesToUpdate.isEmpty\(\)\) {) Tj T* (            update vehiclesToUpdate;) Tj T* (        }) Tj T* (    }) Tj T* (}) Tj T* ET
Q
 

