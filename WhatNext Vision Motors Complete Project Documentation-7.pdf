%PreformattedPara
0 0 0 rg
BT 1 0 0 1 6 203.6 Tm /F5 7.6 Tf 9.6 TL (// Prevent placing an order if stock is zero) Tj T* (private static void preventOrderIfOutOfStock\(List<Vehicle_Order__c> orders\) {) Tj T* (    Set<Id> vehicleIds = new Set<Id>\(\);) Tj T* (    for \(Vehicle_Order__c order : orders\) {) Tj T* (        if \(order.Vehicle__c != null\) {) Tj T* (            vehicleIds.add\(order.Vehicle__c\);) Tj T* (        }) Tj T* (    }) Tj T*  T* (    if \(!vehicleIds.isEmpty\(\)\) {) Tj T* (        Map<Id, Vehicle__c> vehicleStockMap = new Map<Id, Vehicle__c>\() Tj T* (            [SELECT Id, Stock_Quantity__c FROM Vehicle__c WHERE Id IN :vehicleIds]) Tj T* (        \);) Tj T*  T* (        for \(Vehicle_Order__c order : orders\) {) Tj T* (            Vehicle__c vehicle = vehicleStockMap.get\(order.Vehicle__c\);) Tj T* (            if \(vehicle != null && vehicle.Stock_Quantity__c <= 0\) {) Tj T* (                order.addError\('This vehicle is out of stock. Order cannot be placed.'\);) Tj T* (            }) Tj T* (        }) Tj T* (    }) Tj T* (}) Tj T* ET
Q
 

Q

